# Postgres (Neon) — duas connection strings: pooled (runtime) e direta (só migrações)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# NextAuth / Auth.js — gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-um-valor-aleatorio"

# AUTH_URL: defina isso SÓ no .env local (aponta pro localhost). NÃO configure
# essa variável na Vercel — se ela existir lá, o Auth.js usa o valor fixo em
# vez de detectar o domínio real da Vercel, e todo redirecionamento (login,
# checkout etc.) quebra apontando pro localhost. Na Vercel, deixe essa
# variável simplesmente não existir — o Auth.js detecta o host sozinho
# (ver docs/decisoes-fase-8.md).
AUTH_URL="http://localhost:3030"

# Usado só por `pnpm db:seed` (prisma/seed.ts) pra criar o único usuário ADMINISTRADOR
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="troque-por-uma-senha-forte"
